datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  role             String            @default("CANDIDATE")
  createdAt        DateTime          @default(now())
  candidateProfile CandidateProfile?
  recruiterProfile Recruiter?
}

model CandidateProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline     String?
  experience   String?       // JSON string
  education    String?       // JSON string
  location     String?
  skills       String?       // Comma-separated list of skills
  linkedin     String?
  github       String?
  portfolio    String?
  resumeUrl    String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Recruiter {
  id          String   @id @default(uuid())
  userId      String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  designation String?
}

model Company {
  id          String      @id @default(uuid())
  name        String
  website     String?
  logo        String?
  industry    String?
  description String?
  recruiters  Recruiter[]
  jobs        Job[]
}

model Job {
  id             String        @id @default(uuid())
  title          String
  description    String
  requirements   String        // JSON string representation of requirements array
  skills         String        // JSON string representation of skills array
  experience     String
  location       String
  salary         String
  employmentType String
  workplaceType  String        @default("Onsite")
  createdById    String
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  applications   Application[]
}

model Application {
  id          String            @id @default(uuid())
  candidateId String
  candidate   CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeUrl   String?
  resumeText  String?
  status      String            @default("PENDING")
  matchScore  Int               @default(0)
  summary     String?
  createdAt   DateTime          @default(now())
  analysis    AIAnalysis?
}

model AIAnalysis {
  id             String      @id @default(uuid())
  applicationId  String      @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  score          Int
  strengths      String      // JSON string representation of strengths array
  weaknesses     String      // JSON string representation of weaknesses array
  missingSkills  String      // JSON string representation of missingSkills array
  recommendation String
  atsScore       Int
  questions      String      // JSON string representation of questions array
  jsonResponse   String
  createdAt      DateTime    @default(now())
}
