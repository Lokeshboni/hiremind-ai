datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  password         String
  role             Role              @default(CANDIDATE)
  createdAt        DateTime          @default(now())
  candidateProfile CandidateProfile?
  recruiterProfile Recruiter?
}

model CandidateProfile {
  id           String        @id @default(uuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline     String?
  experience   String?       // JSON string
  education    String?       // JSON string
  location     String?
  skills       String[]      // Postgres array of strings
  linkedin     String?
  github       String?
  portfolio    String?
  resumeUrl    String?
  createdAt    DateTime      @default(now())
  applications Application[]
}

model Recruiter {
  id          String   @id @default(uuid())
  userId      String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  designation String?
}

model Company {
  id          String      @id @default(uuid())
  name        String
  website     String?
  logo        String?
  industry    String?
  description String?
  recruiters  Recruiter[]
  jobs        Job[]
}

model Job {
  id             String        @id @default(uuid())
  title          String
  description    String
  requirements   String[]      // Postgres array of strings
  skills         String[]      // Required skills
  experience     String        // e.g. "2+ years", "5-7 years"
  location       String
  salary         String
  employmentType String        // e.g. "Full-time", "Contract", "Part-time"
  workplaceType  String        @default("Onsite") // Onsite, Hybrid, Remote
  createdById    String
  companyId      String
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime      @default(now())
  applications   Application[]
}

model Application {
  id          String            @id @default(uuid())
  candidateId String
  candidate   CandidateProfile  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  resumeUrl   String?
  resumeText  String?           // Extracted raw text from resume
  status      String            @default("PENDING") // PENDING, SCREENING, SHORTLISTED, REJECTED
  matchScore  Int               @default(0)
  summary     String?
  createdAt   DateTime          @default(now())
  analysis    AIAnalysis?
}

model AIAnalysis {
  id             String      @id @default(uuid())
  applicationId  String      @unique
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  score          Int
  strengths      String[]
  weaknesses     String[]
  missingSkills  String[]
  recommendation String
  atsScore       Int
  questions      String[]
  jsonResponse   String      // The full raw JSON returned from the model
  createdAt      DateTime    @default(now())
}
